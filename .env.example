# Discord bot credentials (required)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register commands to a single guild for instant updates during development.
# Leave empty to register globally (can take up to 1 hour to propagate).
GUILD_ID=

# API configuration
# Base URL of the official OpenFront public API.
API_BASE_URL=https://api.openfront.io/public
# Per-request timeout in milliseconds.
API_TIMEOUT_MS=15000
# Maximum number of retries for retryable failures (429/5xx/network).
API_MAX_RETRIES=4

# Cache TTLs in milliseconds.
# Game metadata listing.
CACHE_TTL_GAMES_MS=300000
# Full game detail.
CACHE_TTL_GAME_DETAIL_MS=600000
# Player info/stats.
CACHE_TTL_PLAYER_MS=900000
# Player game history / sessions.
CACHE_TTL_PLAYER_GAMES_MS=300000
# Clan stats.
CACHE_TTL_CLAN_MS=300000
# Clan sessions.
CACHE_TTL_CLAN_SESSIONS_MS=300000
# Clan leaderboard.
CACHE_TTL_LEADERBOARD_MS=600000

# Rate limiting (requests per second, burst size). Per-endpoint throttles in code
# scale relative to these base values — see src/openfront/rateLimiter.ts.
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=5

# Health check HTTP server port.
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info